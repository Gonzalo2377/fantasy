# Base de datos: local (archivo SQLite) o Turso en producción (libsql://...)
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Secreto para firmar las sesiones (pon una cadena larga y aleatoria en producción)
AUTH_SECRET=cambia-esto

# Emails que serán administradores (separados por comas)
ADMIN_EMAILS=

# Protege /api/cron (Vercel lo envía automáticamente como "Authorization: Bearer ...")
CRON_SECRET=

# 1 = el cron intenta leer y aplicar solo las actas de la federación (experimental)
AUTO_IMPORT_ACTAS=0
